# Copiez ce fichier en ".env" (même dossier) puis complétez les valeurs.
# Le fichier .env est ignoré par Git : ne le partagez jamais, ne le collez jamais dans un assistant IA.

# Token Hugging Face "Fine-grained" avec la permission "Make calls to Inference Providers"
HF_TOKEN=

# Facultatif (décommentez pour l’utiliser) : secret de signature des jetons de connexion (32 caractères minimum)
# JWT_SECRET=

# Facultatif (décommentez pour l’utiliser) : compte administrateur créé au premier démarrage
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
